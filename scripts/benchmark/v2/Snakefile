# Snakemake workflow for the v2 CBG benchmark.
#
# Run with:
#   snakemake -s scripts/benchmark/v2/Snakefile \
#       --configfile scripts/benchmark/v2/config/smoke.yaml -j 4
#
# The config file declares the run grid (source × slices × combos).
# Snakemake fans out across combo cells; cells already on disk are skipped.

import json
from pathlib import Path

# ---- Resolve config ---------------------------------------------------------
# Two accepted shapes, resolved by `bcfg` below:
#
#   unified (configs/<run_id>.yaml, see configs/template.yaml)
#       run_id: ...
#       benchmark: {source: ..., slices: [...], combos: [...]}
#       analysis:  {...}            # read by scripts/analysis/v3, ignored here
#
#   flat (scripts/benchmark/v2/config/*.yaml, the original shape)
#       run_id: ...
#       source: ...
#       combos: [...]
#
# A populated `benchmark:` block wins key by key, with the top level as
# fallback, so both shapes work and a unified config can still carry
# `run_id` at the top where the analysis CLI also reads it.
_BENCH = config.get("benchmark") or {}
if not isinstance(_BENCH, dict):
    raise TypeError(
        f"`benchmark:` must be a mapping, got {type(_BENCH).__name__}"
    )

def bcfg(key, default=None):
    """Read `key` from the `benchmark:` block, falling back to the top level."""
    if key in _BENCH:
        return _BENCH[key]
    return config.get(key, default)

_REQUIRED_SENTINEL = object()

def bcfg_required(key):
    value = bcfg(key, _REQUIRED_SENTINEL)
    if value is _REQUIRED_SENTINEL:
        raise KeyError(
            f"config is missing required key {key!r}: put it under "
            f"`benchmark:` (unified config) or at the top level (flat config)"
        )
    return value

RUN_ID  = bcfg("run_id",  "default")
SOURCE  = bcfg_required("source")
SETUP   = bcfg("setup", "probes_to_anchors")     # or "anchors_to_probes"
SLICES  = bcfg("slices", [])
SOURCE_KWARGS = bcfg("source_kwargs", {})
COMBOS  = bcfg_required("combos")                # list of dicts
# Repo-root tree, matching the CLI defaults and where analysis/v3 looks.
INPUTS_ROOT  = Path(bcfg("inputs_root",  "inputs/benchmark/v2"))
OUTPUTS_ROOT = Path(bcfg("outputs_root", "outputs/benchmark/v2"))
ENABLE_FALLBACK = bool(bcfg("enable_fallback", True))

# Build a name → combo dict so we can dispatch by combo_id in the run-combo rule.
def _combo_id(c):
    return c.get("combo_id") or f"{c['ltd']}__{c['mtl']}__{c['ctr']}"

COMBOS_BY_ID = {_combo_id(c): c for c in COMBOS}
COMBO_IDS = list(COMBOS_BY_ID)

CLI = "python -m scripts.benchmark.v2.cli"

# ---- Targets ----------------------------------------------------------------
rule all:
    input:
        f"{OUTPUTS_ROOT}/{RUN_ID}/summary.parquet"

# ---- Materialize one (source, setup, slice) ---------------------------------
# Inputs layout: <INPUTS_ROOT>/<SOURCE>/<RUN_ID>/<SETUP>/<slice>/. RUN_ID isolates
# inputs across runs that share a source but differ in source_kwargs (e.g.
# per-ASN VP corpora under ripe_atlas_asn_corpora).
rule materialize:
    output:
        manifest = INPUTS_ROOT / SOURCE / RUN_ID / SETUP / "{slice}" / "manifest.json",
    params:
        source = SOURCE,
        setup = SETUP,
        run_id = RUN_ID,
        inputs_root = str(INPUTS_ROOT),
        source_kwargs_json = json.dumps(SOURCE_KWARGS),
        # Materialize-time traffic-weighted eval mask (see generic_csv.py):
        # eval targets keep only obs with pair_weight >= this value and drop
        # out entirely when none clears; fit samples stay full-mesh. Changes
        # the materialized inputs, so use a distinct run_id per threshold.
        eval_pair_weight_min_flag = lambda wc: (
            f"--eval-pair-weight-min {bcfg('eval_pair_weight_min')}"
            if bcfg('eval_pair_weight_min') is not None else ""
        ),
        eval_kept_traffic_fraction_flag = lambda wc: (
            f"--eval-kept-traffic-fraction {bcfg('eval_kept_traffic_fraction')}"
            if bcfg('eval_kept_traffic_fraction') is not None else ""
        ),
    shell:
        CLI + " materialize-inputs"
        " --source {params.source}"
        " --slice {wildcards.slice}"
        " --setup {params.setup}"
        " --run-id {params.run_id}"
        " --inputs-root {params.inputs_root}"
        " --source-kwargs '{params.source_kwargs_json}'"
        " {params.eval_pair_weight_min_flag}"
        " {params.eval_kept_traffic_fraction_flag}"

# ---- Run one (slice, combo) -------------------------------------------------
rule run_combo:
    input:
        manifest = INPUTS_ROOT / SOURCE / RUN_ID / SETUP / "{slice}" / "manifest.json",
    output:
        targets = OUTPUTS_ROOT / RUN_ID / SOURCE / SETUP / "{slice}" / "{combo_id}" / "targets.parquet",
        run_meta = OUTPUTS_ROOT / RUN_ID / SOURCE / SETUP / "{slice}" / "{combo_id}" / "run.json",
    params:
        source = SOURCE,
        setup = SETUP,
        run_id = RUN_ID,
        inputs_root = str(INPUTS_ROOT),
        outputs_root = str(OUTPUTS_ROOT),
        enable_fallback = "--enable-fallback" if ENABLE_FALLBACK else "--no-enable-fallback",
        ltd = lambda wc: COMBOS_BY_ID[wc.combo_id]["ltd"],
        mtl = lambda wc: COMBOS_BY_ID[wc.combo_id]["mtl"],
        ctr = lambda wc: COMBOS_BY_ID[wc.combo_id]["ctr"],
        ltd_kwargs = lambda wc: json.dumps(COMBOS_BY_ID[wc.combo_id].get("ltd_kwargs", {})),
        mtl_kwargs = lambda wc: json.dumps(COMBOS_BY_ID[wc.combo_id].get("mtl_kwargs", {})),
        ctr_kwargs = lambda wc: json.dumps(COMBOS_BY_ID[wc.combo_id].get("ctr_kwargs", {})),
        source_kwargs_json = json.dumps(SOURCE_KWARGS),
        # Per-combo seed wins over the run-level default; both are optional.
        #
        # An empty seed_flag leaves `base_seed` None, so runner.py does NOT
        # replace the CTR's generator per target and the CTR keeps whatever it
        # constructed itself. That is no longer the same as "randomize":
        # MonteCarloMedoidCTR.DEFAULT_SEED pins it to 42, so an unseeded config
        # is still reproducible -- just with one generator advancing across
        # targets instead of a per-target seed, which makes it sensitive to
        # target ORDER where a seeded run is not. Declare `seed:` for anything
        # whose numbers get published.
        seed_flag = lambda wc: (
            f"--seed {COMBOS_BY_ID[wc.combo_id]['seed']}"
            if "seed" in COMBOS_BY_ID[wc.combo_id]
            else (f"--seed {bcfg('seed')}" if bcfg('seed') is not None else "")
        ),
        # Traffic-weighted eval threshold; per-combo wins over run-level.
        # Empty flag = unweighted eval over every obs.
        pair_weight_min_flag = lambda wc: (
            f"--pair-weight-min {COMBOS_BY_ID[wc.combo_id]['pair_weight_min']}"
            if "pair_weight_min" in COMBOS_BY_ID[wc.combo_id]
            else (
                f"--pair-weight-min {bcfg('pair_weight_min')}"
                if bcfg('pair_weight_min') is not None else ""
            )
        ),
    shell:
        CLI + " run-combo"
        " --source {params.source} --slice {wildcards.slice} --setup {params.setup}"
        " --ltd {params.ltd} --mtl {params.mtl} --ctr {params.ctr}"
        " --combo-id {wildcards.combo_id}"
        " --run-id {params.run_id}"
        " --ltd-kwargs '{params.ltd_kwargs}'"
        " --mtl-kwargs '{params.mtl_kwargs}'"
        " --ctr-kwargs '{params.ctr_kwargs}'"
        " --source-kwargs '{params.source_kwargs_json}'"
        " --inputs-root {params.inputs_root}"
        " --outputs-root {params.outputs_root}"
        " {params.enable_fallback}"
        " {params.seed_flag}"
        " {params.pair_weight_min_flag}"

# ---- Summarize once all combos are done -------------------------------------
rule summarize:
    input:
        expand(
            str(OUTPUTS_ROOT / RUN_ID / SOURCE / SETUP / "{slice}" / "{combo_id}" / "targets.parquet"),
            slice=SLICES, combo_id=COMBO_IDS,
        ),
    output:
        OUTPUTS_ROOT / RUN_ID / "summary.parquet",
    params:
        run_id = RUN_ID,
        outputs_root = str(OUTPUTS_ROOT),
    shell:
        CLI + " summarize --run-id {params.run_id} --outputs-root {params.outputs_root}"
